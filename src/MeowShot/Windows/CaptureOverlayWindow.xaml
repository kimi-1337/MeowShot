<Window x:Class="MeowShot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF393643" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Image x:Name="DesktopImage" Stretch="Fill" />
        <Canvas x:Name="DimCanvas" Background="Transparent"
                MouseLeftButtonDown="DimCanvas_MouseLeftButtonDown"
                MouseMove="DimCanvas_MouseMove"
                MouseLeftButtonUp="DimCanvas_MouseLeftButtonUp" />

        <Border x:Name="Toolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Padding="6"
                CornerRadius="10"
                Background="#F0202020"
                Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RectangleButton" Content="▭  Область" Tag="Rectangle" Click="ModeButton_Click" />
                <Button x:Name="WindowButton" Content="▣  Окно" Tag="Window" Click="ModeButton_Click" />
                <Button x:Name="ScreenButton" Content="▰  Экран" Tag="FullScreen" Click="ModeButton_Click" />
                <Separator Margin="6,2" />
                <Button x:Name="QuickActionsToggleButton" Click="QuickActionsToggleButton_Click"
                        ToolTip="Переключить подтверждение снимка" />
                <Separator Margin="6,2" />
                <Button Content="✕" ToolTip="Отмена (Esc)" Click="CancelButton_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="QuickActionsPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,66"
                Padding="7"
                CornerRadius="10"
                Background="#F0202020"
                Visibility="Collapsed"
                Panel.ZIndex="200"
                IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal">
                <Button Content="✓  Готово" Click="CompleteButton_Click" ClickMode="Press"
                        Background="#FF7C5CFC" Foreground="White" />
                <Button Content="✎  Редактировать" Click="EditButton_Click" ClickMode="Press" />
                <Button Content="⇩  Сохранить" Click="SaveButton_Click" ClickMode="Press" />
                <Button Content="✕" ToolTip="Выбрать заново" Click="ResetSelectionButton_Click" ClickMode="Press" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Padding="12,7"
                CornerRadius="7"
                Background="#D0202020"
                IsHitTestVisible="False"
                Panel.ZIndex="10">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="14"
                       Text="Зажмите левую кнопку мыши и выделите область · Esc — отмена" />
        </Border>
    </Grid>
</Window>
