<Window x:Class="MeowShot.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeowShot — Редактор"
        Width="1240" Height="850"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF111018"
        Foreground="White"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF353241" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFECE9F4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF7C5CFC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFA693FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF393546" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#FF8D70FF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF17131E" />
            <Setter Property="Background" Value="#FFF1EFF7" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF191722" BorderBrush="#FF2D2A38" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                        <Image Source="/MeowShot;component/Assets/meowshot-logo.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Редактор MeowShot" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImageSizeText" Foreground="#FF9993A8" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Копировать" ToolTip="Ctrl+C" Click="CopyButton_Click" />
                    <Button Content="Сохранить…" ToolTip="Ctrl+S" Click="SaveButton_Click"
                            Background="#FF7C5CFC" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FF201E29" Padding="8,5"
                BorderBrush="#FF2D2A38" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <RadioButton Content="✂  Обрезка" Tag="Crop" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="✎  Перо" Tag="Pen" GroupName="Tools" Checked="Tool_Checked"
                             IsChecked="True" Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="●  Кисть" Tag="Brush" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="▰  Маркер" Tag="Highlighter" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="◌  Размытие" Tag="Blur" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="▦  Пиксели" Tag="Pixelate" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="■  Закраска" Tag="Fill" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="╱  Линия" Tag="Line" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="➜  Стрелка" Tag="Arrow" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="▭  Прямоугольник" Tag="Rectangle" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="◯  Эллипс" Tag="Ellipse" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="T  Текст" Tag="Text" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="①  Шаг" Tag="Step" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="⌫  Ластик" Tag="Eraser" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="#FF191821" Padding="10,6"
                BorderBrush="#FF2D2A38" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Цвет" Foreground="#FFC8C3D2" VerticalAlignment="Center" Margin="4,0,6,0" />
                    <Border x:Name="ColorPreview" Width="22" Height="22" CornerRadius="6"
                            Background="#FFFF3B30" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                    <ComboBox x:Name="ColorComboBox" Width="112" SelectedIndex="0"
                              SelectionChanged="ColorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Красный" Tag="#FFFF3B30" />
                        <ComboBoxItem Content="Жёлтый" Tag="#FFFFD60A" />
                        <ComboBoxItem Content="Зелёный" Tag="#FF30D158" />
                        <ComboBoxItem Content="Голубой" Tag="#FF64D2FF" />
                        <ComboBoxItem Content="Белый" Tag="#FFFFFFFF" />
                        <ComboBoxItem Content="Чёрный" Tag="#FF000000" />
                    </ComboBox>
                    <TextBlock x:Name="StrokeLabel" Text="Толщина" Foreground="#FFC8C3D2"
                               VerticalAlignment="Center" Margin="14,0,6,0" />
                    <Slider x:Name="StrokeWidthSlider" Width="120" Minimum="1" Maximum="24" Value="4"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="StrokeWidthSlider_ValueChanged" />
                    <TextBlock Text="4" x:Name="StrokeValueText" Width="28" TextAlignment="Center"
                               Foreground="#FFC8C3D2" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="UndoButton" Content="↶" ToolTip="Отменить · Ctrl+Z" Click="UndoButton_Click" />
                    <Button x:Name="RedoButton" Content="↷" ToolTip="Повторить · Ctrl+Y" Click="RedoButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Масштаб" Foreground="#FFC8C3D2" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Button Content="−" ToolTip="Уменьшить" Click="ZoomOutButton_Click" />
                    <Slider x:Name="ZoomSlider" Width="96" Minimum="10" Maximum="300" Value="100"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <Button Content="＋" ToolTip="Увеличить" Click="ZoomInButton_Click" />
                    <Button Content="Вписать" ToolTip="Вписать снимок в окно" Click="FitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="12" Background="#FF0D0C12">
            <ScrollViewer x:Name="ArtworkScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="ArtworkScrollViewer_SizeChanged"
                          Background="#FF0D0C12">
                <Border x:Name="ArtworkScaleHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#FF3A3647" BorderThickness="1" Background="#FF17151D">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="ArtworkScaleTransform" ScaleX="1" ScaleY="1" />
                    </Border.LayoutTransform>
                    <Canvas x:Name="ArtCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="ArtCanvas_MouseLeftButtonDown"
                            MouseMove="ArtCanvas_MouseMove"
                            MouseLeftButtonUp="ArtCanvas_MouseLeftButtonUp">
                        <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False" />
                    </Canvas>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" Background="#FF191722" BorderBrush="#FF2D2A38" BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock Text="Ctrl+колесо — масштаб · Ctrl+Z/Y — отмена/повтор · Ctrl+C/S — копировать/сохранить"
                           Foreground="#FF8F899D" FontSize="11" />
                <TextBlock x:Name="ZoomText" Text="100%" Foreground="#FFC4BED0" FontSize="11"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
