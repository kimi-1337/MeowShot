<Window x:Class="MeowShot.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeowShot — Редактор"
        Width="1200" Height="820"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF333333" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF7C5CFC" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="#FF181818">
        <Border DockPanel.Dock="Top" Background="#FF252525" Padding="8">
            <WrapPanel VerticalAlignment="Center">
                <RadioButton Content="Обрезка" Tag="Crop" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Перо" Tag="Pen" GroupName="Tools" Checked="Tool_Checked"
                             IsChecked="True" Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Маркер" Tag="Highlighter" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Линия" Tag="Line" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Стрелка" Tag="Arrow" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Прямоугольник" Tag="Rectangle" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Эллипс" Tag="Ellipse" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Текст" Tag="Text" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
                <RadioButton Content="Ластик" Tag="Eraser" GroupName="Tools" Checked="Tool_Checked"
                             Style="{StaticResource ToolButtonStyle}" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FF202020" Padding="8,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Цвет" Foreground="White" VerticalAlignment="Center" Margin="5,0" />
                    <ComboBox x:Name="ColorComboBox" Width="115" SelectedIndex="0">
                        <ComboBoxItem Content="Красный" Tag="#FFFF3B30" />
                        <ComboBoxItem Content="Жёлтый" Tag="#FFFFD60A" />
                        <ComboBoxItem Content="Зелёный" Tag="#FF30D158" />
                        <ComboBoxItem Content="Голубой" Tag="#FF64D2FF" />
                        <ComboBoxItem Content="Белый" Tag="#FFFFFFFF" />
                        <ComboBoxItem Content="Чёрный" Tag="#FF000000" />
                    </ComboBox>
                    <TextBlock Text="Толщина" Foreground="White" VerticalAlignment="Center" Margin="14,0,5,0" />
                    <Slider x:Name="StrokeWidthSlider" Width="110" Minimum="1" Maximum="24" Value="4"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <Button Content="↶ Отменить" Click="UndoButton_Click" />
                    <Button Content="↷ Повторить" Click="RedoButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Копировать" Click="CopyButton_Click" />
                    <Button Content="Сохранить…" Click="SaveButton_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="14">
            <Viewbox x:Name="ArtworkViewbox" Stretch="Uniform" StretchDirection="DownOnly">
                <Canvas x:Name="ArtCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="ArtCanvas_MouseLeftButtonDown"
                        MouseMove="ArtCanvas_MouseMove"
                        MouseLeftButtonUp="ArtCanvas_MouseLeftButtonUp">
                    <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False" />
                </Canvas>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
