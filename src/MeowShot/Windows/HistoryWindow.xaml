<Window x:Class="MeowShot.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeowShot — История"
        Width="900" Height="650"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="История снимков" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Открыть в редакторе" Click="OpenButton_Click" />
            <Button Content="Удалить выбранный" Click="DeleteButton_Click" />
            <Button Content="Закрыть" Click="CloseButton_Click" />
        </StackPanel>

        <ListBox x:Name="HistoryList" MouseDoubleClick="HistoryList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="250" Margin="7" Padding="8" CornerRadius="7" Background="#0F808080">
                        <StackPanel>
                            <Image Source="{Binding Thumbnail}" Width="230" Height="140" Stretch="Uniform" />
                            <TextBlock Text="{Binding DisplayName}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
