<Window x:Class="MeowShot.Windows.CaptureToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" Height="156"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Border Margin="8" Padding="14" CornerRadius="14"
            Background="#FA211F2A" BorderBrush="#FF4A4560" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="62" Height="62" CornerRadius="13" ClipToBounds="True"
                    VerticalAlignment="Top" Background="#FF332F43">
                <Image Source="/MeowShot;component/Assets/meowshot-logo.png" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Снимок готов" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailsText" Foreground="#FFB9B4C7" FontSize="12"
                           Margin="0,3,0,8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Редактировать" Click="EditButton_Click"
                            Background="#FF7C5CFC" Foreground="White" />
                    <Button Content="Сохранить как…" Click="SaveButton_Click"
                            Background="#FF393548" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
