<Window x:Class="MeowShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeowShot — Настройки"
        Width="900" Height="780"
        MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF111018"
        Foreground="#FFF7F5FF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1D1B27" />
        <SolidColorBrush x:Key="ControlBrush" Color="#FF2A2736" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA9A5B8" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF373346" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF1EFF8" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder" Width="17" Height="17" CornerRadius="4"
                                    Background="#FF2A2736" BorderBrush="#FF5A556B" BorderThickness="1">
                                <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#FF7C5CFC" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#FF9A83FF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#FFC0B4FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="#FF4B465C" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style x:Key="BehaviorRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFECE9F4" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Background="#FF292633" BorderBrush="#FF3B3749"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="8" BorderThickness="2"
                                        BorderBrush="#FF716B82" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FFB8A8FF"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#2F7C5CFC" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#FF7C5CFC" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#FF8D7DCE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="#FF292634" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="17" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#FF181621" BorderBrush="#FF2A2736" BorderThickness="0,0,1,0">
            <Grid Margin="24,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border CornerRadius="22" ClipToBounds="True" Width="128" Height="128"
                            HorizontalAlignment="Left" Background="#FF282435">
                        <Image Source="/MeowShot;component/Assets/meowshot-logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="MeowShot" FontSize="27" FontWeight="Bold" Margin="0,17,0,2" />
                    <TextBlock Text="by kimi" Foreground="#FFDCA5FF" FontWeight="SemiBold" />
                    <Border Background="#267C5CFC" BorderBrush="#667C5CFC" BorderThickness="1"
                            CornerRadius="8" Padding="9,5" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Версия 0.1.2" Foreground="#FFD9D0FF" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl + Shift + S" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Глобальная клавиша захвата" Style="{StaticResource CaptionStyle}" Margin="0,4,0,16" />
                    <Button Content="＋  Новый снимок" HorizontalAlignment="Stretch"
                            Background="#FF7C5CFC" Click="CaptureButton_Click" />
                    <Button Content="▣  Открыть историю" HorizontalAlignment="Stretch"
                            Click="OpenHistoryButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Локально · без аналитики&#x0a;PNG без потери качества"
                           Style="{StaticResource CaptionStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="2,0,0,16">
                <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Захват, уведомления и хранение снимков"
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,2">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="После снимка" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel x:Name="AfterCapturePanel">
                                <RadioButton Content="Копировать и показать уведомление" Tag="CopyAndNotify"
                                             GroupName="AfterCapture" Checked="AfterCaptureRadio_Checked"
                                             Style="{StaticResource BehaviorRadioStyle}" />
                                <RadioButton Content="Копировать и сразу открыть редактор" Tag="CopyAndEdit"
                                             GroupName="AfterCapture" Checked="AfterCaptureRadio_Checked"
                                             Style="{StaticResource BehaviorRadioStyle}" />
                                <RadioButton Content="Только копировать в буфер" Tag="CopyOnly"
                                             GroupName="AfterCapture" Checked="AfterCaptureRadio_Checked"
                                             Style="{StaticResource BehaviorRadioStyle}" />
                                <RadioButton Content="Копировать, сохранить и уведомить" Tag="SaveAndNotify"
                                             GroupName="AfterCapture" Checked="AfterCaptureRadio_Checked"
                                             Style="{StaticResource BehaviorRadioStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="NotificationsCheckBox" Margin="0,11,0,5"
                                      Content="Показывать уведомления со снимком и действиями" />
                            <CheckBox x:Name="QuickActionsCheckBox"
                                      Content="Спрашивать действие после выделения области" />
                            <TextBlock Text="Если выключено, снимок создаётся сразу после отпускания кнопки мыши. Режим также переключается на верхней панели захвата."
                                       Style="{StaticResource CaptionStyle}" Margin="28,1,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Захват и запуск" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Запускать MeowShot вместе с Windows" />
                            <CheckBox x:Name="IncludeCursorCheckBox" Content="Показывать курсор на снимке" />
                            <CheckBox x:Name="AllMonitorsCheckBox"
                                      Content="В режиме «Весь экран» захватывать все мониторы" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Сохранение" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="AutoSaveCheckBox" Content="Автоматически сохранять каждый снимок"
                                      Checked="AutoSaveCheckBox_Changed" Unchecked="AutoSaveCheckBox_Changed" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SaveDirectoryTextBox" Height="36" Padding="9,6" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Выбрать…" Click="BrowseButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="История" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="HistoryCheckBox" Content="Хранить локальную историю снимков"
                                      Checked="HistoryCheckBox_Changed" Unchecked="HistoryCheckBox_Changed" />
                            <StackPanel x:Name="HistoryLimitPanel" Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Максимум снимков:" VerticalAlignment="Center" Foreground="#FFD8D4E2" />
                                <TextBox x:Name="HistoryLimitTextBox" Width="64" Margin="10,0,0,0"
                                         Padding="7,5" TextAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}"
                                       Text="История по умолчанию выключена и хранится только в %LocalAppData%\MeowShot." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Изменения применятся к следующему снимку" VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Отмена" Click="CancelButton_Click" />
                    <Button Content="Сохранить" Click="SaveButton_Click"
                            Background="#FF7C5CFC" Foreground="White" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
