<Window x:Class="MeowShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeowShot — Настройки"
        Width="860" Height="760"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#FF111118"
        Foreground="#FFF7F5FF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1E1D29" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA9A5B8" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF343143" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF1EFF8" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF292735" />
            <Setter Property="BorderBrush" Value="#FF454158" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF17131E" />
            <Setter Property="Background" Value="#FFF0EDF8" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#FF191722" BorderBrush="#FF2A2736" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border CornerRadius="24" ClipToBounds="True" Width="150" Height="150"
                            HorizontalAlignment="Left" Background="#FF282435">
                        <Image Source="Assets/meowshot-logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="MeowShot" FontSize="27" FontWeight="Bold" Margin="0,18,0,2" />
                    <TextBlock Text="by kimi" Foreground="#FFDCA5FF" FontWeight="SemiBold" />
                    <Border Background="#267C5CFC" BorderBrush="#667C5CFC" BorderThickness="1"
                            CornerRadius="10" Padding="9,5" Margin="0,16,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Версия 0.1.1" Foreground="#FFD9D0FF" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl + Shift + S" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Глобальная клавиша захвата" Style="{StaticResource CaptionStyle}" Margin="0,4,0,18" />
                    <Button Content="＋  Новый снимок" HorizontalAlignment="Stretch"
                            Background="#FF7C5CFC" Click="CaptureButton_Click" />
                    <Button Content="▣  Открыть историю" HorizontalAlignment="Stretch"
                            Click="OpenHistoryButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Локально · без аналитики&#x0a;PNG без потери качества"
                           Style="{StaticResource CaptionStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="2,0,0,18">
                <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Настройте захват под себя — изменения остаются только на этом компьютере."
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="После снимка" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Основное действие" Style="{StaticResource CaptionStyle}" Margin="0,0,0,5" />
                            <ComboBox x:Name="AfterCaptureComboBox" SelectedIndex="0" Margin="0,0,0,7"
                                      SelectionChanged="AfterCaptureComboBox_SelectionChanged">
                                <ComboBoxItem Content="Копировать и показать уведомление" Tag="CopyAndNotify" />
                                <ComboBoxItem Content="Копировать и сразу открыть редактор" Tag="CopyAndEdit" />
                                <ComboBoxItem Content="Только копировать в буфер" Tag="CopyOnly" />
                                <ComboBoxItem Content="Копировать, сохранить и уведомить" Tag="SaveAndNotify" />
                            </ComboBox>
                            <CheckBox x:Name="NotificationsCheckBox"
                                      Content="Показывать уведомления со снимком и действиями" />
                            <CheckBox x:Name="QuickActionsCheckBox"
                                      Content="Показывать панель действий после выделения области" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Захват и запуск" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Запускать MeowShot вместе с Windows" />
                            <CheckBox x:Name="IncludeCursorCheckBox" Content="Показывать курсор на снимке" />
                            <CheckBox x:Name="AllMonitorsCheckBox"
                                      Content="В режиме «Весь экран» захватывать все мониторы" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Сохранение" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="AutoSaveCheckBox" Content="Автоматически сохранять каждый снимок"
                                      Checked="AutoSaveCheckBox_Changed" Unchecked="AutoSaveCheckBox_Changed" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SaveDirectoryTextBox" Height="36" Padding="9,6" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Выбрать…" Click="BrowseButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="История" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="HistoryCheckBox" Content="Хранить локальную историю снимков"
                                      Checked="HistoryCheckBox_Changed" Unchecked="HistoryCheckBox_Changed" />
                            <StackPanel x:Name="HistoryLimitPanel" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Максимум снимков:" VerticalAlignment="Center" Foreground="#FFD8D4E2" />
                                <TextBox x:Name="HistoryLimitTextBox" Width="64" Margin="10,0,0,0"
                                         Padding="7,5" TextAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}"
                                       Text="История по умолчанию выключена и хранится только в %LocalAppData%\MeowShot." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="Настройки применятся к следующему снимку" VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Click="CancelButton_Click" />
                    <Button Content="Сохранить" Click="SaveButton_Click"
                            Background="#FF7C5CFC" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
